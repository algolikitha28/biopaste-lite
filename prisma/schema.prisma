generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BioPaste {
  id          String   @id @default(cuid())
  title       String?
  content     String
  pasteType   String   @default("TEXT")

  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  maxViews    Int?
  viewCount   Int      @default(0)

  @@index([expiresAt])
}